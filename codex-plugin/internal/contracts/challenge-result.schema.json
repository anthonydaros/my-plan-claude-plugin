{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "my-plan/challenge-result",
  "title": "Challenge Result",
  "description": "Advisory second opinion for discovery and brainstorm. Separates what is proven from what is assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "facts",
    "inferences",
    "agreements",
    "disagreements",
    "questions",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array",
      "description": "Claims verified against a named source. A fact without evidence belongs in inferences.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "string",
            "description": "Repository path with line range, or source title plus URL and access date.",
            "minLength": 1
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "basis", "confidence"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "agreements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "position", "reason"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "position": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array",
      "description": "Material ambiguities only. A reversible technical mechanic with one safer option is not a question.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "header", "prompt", "options", "recommendedOptionId", "why"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "header": { "type": "string", "minLength": 1, "maxLength": 12 },
          "prompt": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "tradeoff"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "tradeoff": { "type": "string", "minLength": 1 }
              }
            }
          },
          "recommendedOptionId": { "type": "string", "minLength": 1 },
          "why": {
            "type": "string",
            "description": "Why this cannot be answered from repository evidence.",
            "minLength": 1
          }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 1 }
  }
}
